{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lost-board",
  "version": "0.1.0",
  "identifier": "dev.lostboard.app",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "lost-board",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon512.png"
    ],
    "shortDescription": "Personal dashboard launcher",
    "longDescription": "Single-user local dashboard: folders, solutions, bookmarks, Azure DevOps, Spotify, weather, news, healthcheck, and system stats in a customizable grid."
  }
}
